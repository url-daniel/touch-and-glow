generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  pending
  successful
  failed
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  priceKobo   Int // price in kobo (NGN * 100) — avoids float rounding on money
  imageUrl    String
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]

  @@index([slug])
}

model Order {
  id                String      @id @default(cuid())
  customerName      String
  customerEmail     String
  customerPhone     String?
  shippingAddress   String
  totalKobo         Int
  status            OrderStatus @default(pending)
  paystackReference String      @unique // idempotency key — one order per Paystack transaction
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items OrderItem[]

  @@index([paystackReference])
  @@index([customerEmail])
}

// Snapshot of product name/price at time of purchase — order history
// must never change if the live product is edited or deleted later.
model OrderItem {
  id            String @id @default(cuid())
  orderId       String
  productId     String
  productName   String
  unitPriceKobo Int
  quantity      Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}
