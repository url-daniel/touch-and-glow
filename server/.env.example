# Database — Postgres connection string (Supabase, Neon, Railway, or your own)
DATABASE_URL="postgresql://user:password@host:5432/touch_and_glow?schema=public"

# Paystack (optional / legacy fallback)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Shopify Server Configuration (optional, for webhooks from Shopify)
SHOPIFY_STORE_DOMAIN="your-store-name.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN="your_storefront_access_token"
SHOPIFY_WEBHOOK_SECRET="your_shopify_webhook_secret_from_shopify_admin"

# Port this Express server listens on
PORT=4000

# URL of the deployed frontend, used for CORS
CLIENT_URL="http://localhost:5173"
